{
  "name": "passendplanen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:data": "node --import tsx scripts/validate-data.ts",
    "sync:products": "node --import tsx scripts/awin/sync-products.ts",
    "review:products": "node --import tsx scripts/awin/review-status.ts",
    "verify:static": "node --import tsx scripts/verify-static-build.ts",
    "audit:site": "node --import tsx scripts/audit-static-site.ts",
    "audit:content": "node --import tsx scripts/audit-content-depth.ts",
    "audit:content:strict": "node --import tsx scripts/audit-content-depth.ts --strict",
    "audit:projects": "node --import tsx scripts/audit-project-examples.ts",
    "audit:decisions": "node --import tsx scripts/audit-decision-guides.ts",
    "readiness": "node --import tsx scripts/check-launch-readiness.ts",
    "readiness:public": "node --import tsx scripts/check-launch-readiness.ts --mode=public --strict",
    "readiness:affiliate": "node --import tsx scripts/check-launch-readiness.ts --mode=affiliate --strict",
    "verify": "npm run validate:data && npm run test && npm run typecheck && npm run audit:projects && npm run audit:decisions && npm run build && npm run verify:static && npm run audit:site"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "csv-parse": "^6.1.0",
    "gunzip-maybe": "^1.4.2",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/gunzip-maybe": "^1.4.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
