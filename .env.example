# Complete Awin feed URLs belong in GitHub Actions Secrets only.
AWIN_FEED_URLS_JSON=[]

# Canonical production origin used for metadata, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://www.passendplanen.de
NEXT_PUBLIC_LEGAL_EMAIL=info@passendplanen.de
# Optional Google Search Console HTML-tag verification token.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Use direct merchant URLs while affiliate tracking is being reviewed. Set to true for Awin links.
NEXT_PUBLIC_USE_AFFILIATE_LINKS=false
